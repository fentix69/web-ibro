{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Entwurf: laeuft vorerst nur auf der workers.dev-Testadresse.
  // Vor Livegang (erst wenn ein Auftrag vorliegt): Namen auf "web-ibro"
  // aendern und die echte Domain als Custom Domain / Route ergaenzen.
  "name": "web-ibro-entwurf",
  "compatibility_date": "2026-09-01",

  // Reiner Static-Assets-Worker: die Seite ist vollstaendig statisch
  // (Astro output "static"), deshalb kein "main"-Skript noetig.
  "assets": {
    "directory": "./dist"
  },

  "observability": {
    "enabled": true
  }
}
