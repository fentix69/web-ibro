---
interface LeistungsGruppe {
  title?: string;
  items: string[];
}

interface Props {
  id: string;
  bg?: "paper" | "tint";
  reverse?: boolean;
  kicker: string;
  name: string;
  lead: string;
  extra?: string;
  groups: LeistungsGruppe[];
}

const { id, bg = "paper", reverse = false, kicker, name, lead, extra, groups } = Astro.props;
const background = bg === "tint" ? "var(--paper-tint)" : "var(--paper)";
---

<section id={id} class="reveal px-6 py-20 md:py-24" style={`background: ${background};`}>
  <div class={`mx-auto grid max-w-[1160px] gap-14 md:grid-cols-2 ${reverse ? "md:[&>*:first-child]:order-2" : ""}`}>
    <div>
      <div class="mb-5" style="color: var(--ink);">
        <slot name="icon" />
      </div>
      <p class="mb-2 text-[15px]" style="color: var(--muted);">{kicker}</p>
      <h3 class="display mb-5 text-[28px] md:text-[34px]" style="color: var(--ink);">{name}</h3>
      <p class="body-copy mb-4 max-w-[520px] text-[17px]" style="color: #3a434c;">{lead}</p>
      {extra && (
        <p class="body-copy max-w-[520px] text-[16px]" style="color: var(--muted);">{extra}</p>
      )}
    </div>

    <div class="pt-1 md:pt-[78px]">
      {groups.map((group) => (
        <div class="mb-6 last:mb-0">
          {group.title && (
            <p class="mb-3 text-[15px] font-semibold" style="color: var(--ink);">{group.title}</p>
          )}
          <ul class="hairline-list">
            {group.items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
