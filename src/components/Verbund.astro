---
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";
import FactStrip from "./FactStrip.astro";

const eckdaten = [
  { value: "1990", label: "Gründung am Stadtrand von Rostock" },
  { value: "2006", label: "Ausgliederung in eigene Tochtergesellschaften" },
  { value: "4", label: "eigenständige Unternehmen unter einem Dach" },
];
---

<section id="verbund" class="relative isolate scroll-mt-28 overflow-hidden py-20 sm:py-28">
  <div class="verbund-grund" aria-hidden="true"></div>

  <Container class="relative z-10">
    <SectionHeading
      eyebrow="Firmenverbund"
      title="Unsere Stärke ist unser Firmenverbund."
      lead="Über die Jahre sind aus einem Unternehmen vier eigenständige Gesellschaften geworden — jede mit eigenem Schwerpunkt, gemeinsam getragen von derselben Verwaltungsgesellschaft."
    />

    <div class="mt-12 max-w-[46rem]" data-reveal-item>
      <FactStrip facts={eckdaten} />
    </div>
  </Container>
</section>

<style>
  .verbund-grund {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        36rem 24rem at 15% 0%,
        color-mix(in srgb, var(--color-blue) 10%, transparent),
        transparent 70%
      ),
      var(--color-surface);
  }
</style>
