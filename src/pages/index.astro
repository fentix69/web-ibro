      {
        title: "Verwaltungsdienstleistungen für die Tochtergesellschaften",
        items: [
          "Qualitätsmanagement",
          "Datenschutz und Informationssicherheit",
          "IT-Dienstleistungen",
          "Personalwesen",
          "Buchhaltung und Controlling",
          "Facilitymanagement",
          "Brand- und Umweltschutz",
          "Arbeits- und Gesundheitsschutz",
          "Räumliche und technische Ressourcen",
        ],
      },
    ]}
  >
    <Fragment slot="sparte">Verwaltungsgesellschaft</Fragment>

    <Fragment slot="icon">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <circle cx="28" cy="28" r="9" stroke="currentColor" stroke-width="1.6"></circle>
        <g stroke="currentColor" stroke-width="1.6">
          <line x1="28" y1="4" x2="28" y2="13"></line>
          <line x1="28" y1="43" x2="28" y2="52"></line>
          <line x1="4" y1="28" x2="13" y2="28"></line>
          <line x1="43" y1="28" x2="52" y2="28"></line>
          <line x1="11.5" y1="11.5" x2="17.8" y2="17.8"></line>
          <line x1="38.2" y1="38.2" x2="44.5" y2="44.5"></line>
          <line x1="44.5" y1="11.5" x2="38.2" y2="17.8"></line>
          <line x1="17.8" y1="38.2" x2="11.5" y2="44.5"></line>
        </g>
      </svg>
    </Fragment>
  </Division>

  <Division
    id="funk"
    index="02"
    bg="muted"
    kicker="Tochtergesellschaft seit 2006, hervorgegangen aus dem Geschäftsbereich Funk von 1991."
    name="IBRo Funk GmbH"
    lead="Ihr regionaler Fachhändler für stationäre und mobile Kommunikationstechnik in Mecklenburg-Vorpommern — von der Planung über Vertrieb und Montage bis zur Reparatur."
    extra="Geblieben sind wir die Gleichen: Ihr Kommunikationsspezialist, seit 1991."
    groups={[
      {
        title: "Leistungen",
        items: [
          "Beratung und Planung",
          "Verkauf, Montage und Einweisung",
          "Einbau in alle Fahrzeugtypen — Landmaschinen, LKW, Spezialmaschinen",
          "Reparatur und Optimierung bestehender Funktechnik, inklusive Programmierung",
          "Telefonanlagen des Herstellers Auerswald, als autorisierter Advanced Partner",
        ],
      },
    ]}
  >
    <Fragment slot="sparte">Kommunikationstechnik</Fragment>

    <Fragment slot="icon">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <line x1="28" y1="52" x2="28" y2="20" stroke="currentColor" stroke-width="1.6"></line>
        <path d="M17 30 Q28 16 39 30" stroke="currentColor" stroke-width="1.6" fill="none"></path>
        <path d="M11 36 Q28 12 45 36" stroke="currentColor" stroke-width="1.6" fill="none"></path>
        <circle cx="28" cy="16" r="3.2" fill="currentColor"></circle>
      </svg>
    </Fragment>
  </Division>

  <Division
    id="service"
    index="03"
    bg="surface"
    kicker="Tochtergesellschaft seit 2006, hervorgegangen aus dem Geschäftsbereich Telefonmarketing von 1991."
    name="IBRo Service GmbH"
    lead="Ihr Draht zum Kunden: Communication-Center-Leistungen in allen Dialogdisziplinen, über Telefon, Fax, Mailing, Internet, E-Mail und soziale Netzwerke."
    extra="Qualität und Quantität, Datenschutz und Informationssicherheit sind für uns täglich gelebte Praxis."
    groups={[
      {
        title: "Inbound",
        items: [
          "Bürger- und Informationshotline",
          "Produktberatung und telefonische Bestellaufnahme",
          "Telefonische Sachbearbeitung",
          "Responsemarketing für Print, TV und Werbeaktionen",
          "Reklamationshotline und Beschwerdemanagement",
        ],
      },
      {
        title: "Outbound",
        items: [
          "Marktforschung und Kundenbefragungen",
          "Vertriebsvorbereitung und -unterstützung",
          "Messevor- und -nachbereitung",
          "Adresserfassung und -qualifizierung",
        ],
      },
      {
        title: "Rundum-Service",
        items: [
          "Problemorientierte Lösungsvorschläge",
          "Erarbeitung firmeninterner Unterlagen",
          "Entwicklung von Telefonmarketingstrategien",
          "Telefontraining und Kommunikationsausbildung",
          "Qualitätssicherung durch Coaching und Monitoring",
        ],
      },
    ]}
