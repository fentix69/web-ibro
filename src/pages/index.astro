    <Fragment slot="sparte">Communication-Center</Fragment>

    <Fragment slot="icon">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <path d="M14 28a14 14 0 0 1 28 0v10a4 4 0 0 1-4 4h-3v-12h7" stroke="currentColor" stroke-width="1.6" fill="none"></path>
        <path d="M14 28v10a4 4 0 0 0 4 4h3v-12h-7" stroke="currentColor" stroke-width="1.6" fill="none"></path>
      </svg>
    </Fragment>
  </Division>

  <Division
    id="versand"
    index="04"
    bg="muted"
    kicker="Seit über 30 Jahren Logistik- und Fulfillment-Dienstleister mit eigenem Logistikzentrum."
    name="IBRo Versandservice GmbH"
    lead="In gepflegten Hochregallagern lagert Ihre Ware trocken, sauber und lichtgeschützt. Wir übernehmen Bestell-, Reklamations- und Retourenbearbeitung und lösen auf Wunsch Zahlungsüberwachung und Inkassoverfahren aus."
    extra="Auf Wunsch mit eigenem Online-Tool für tagesaktuelle Warenbewegungen und -bestände — als Komplettlösung oder Teilleistung."
    groups={[
      {
        title: "Leistungen im Überblick",
        items: [
          "Beratung und Planung, inklusive Webshop-Lösungen",
          "Bestellannahme — klassisch oder per Schnittstelle",
          "Kundenbetreuung, Rechnungsstellung, Retourenmanagement",
          "Druck von Mailings und Rechnungen",
          "Kommissionierung und Konfektionierung",
          "Frankierung, Speditions- und Terminversand",
          "Lagerhaltung und -verwaltung",
          "Datenschutzkonforme Entsorgung",
          "Qualitätssicherung nach DIN&nbsp;EN&nbsp;ISO&nbsp;9001-2015",
        ],
      },
    ]}
  >
    <Fragment slot="sparte">Logistik und Fulfillment</Fragment>

    <Fragment slot="icon">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <rect x="6" y="30" width="18" height="18" stroke="currentColor" stroke-width="1.6"></rect>
        <rect x="26" y="30" width="18" height="18" stroke="currentColor" stroke-width="1.6"></rect>
        <rect x="16" y="10" width="18" height="18" stroke="currentColor" stroke-width="1.6"></rect>
      </svg>
    </Fragment>
  </Division>

  <Kontakt />
</BaseLayout>

<script>
  /*
   * Einblenden beim Scrollen.
   *
   * Die Deckkraft liegt an den einzelnen Elementen, nie am Abschnitt:
   * ein Vorfahr mit einer Deckkraft zwischen 0 und 1 macht eine eigene
   * Composite-Ebene auf, und dann filtert `backdrop-filter` nur noch
   * innerhalb dieser Ebene — die Glasflaechen saehen flach aus.
   *
   * Die Staffelung laeuft je Abschnitt, damit die Elemente eines
   * Abschnitts als eine Bewegung erscheinen und nicht einzeln eintrudeln.
   */
  const wenigerBewegung = window.matchMedia("(prefers-reduced-motion: reduce)");

  const elemente = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reveal-item]"),
  );

  /* Ohne IntersectionObserver gaebe es niemanden, der die Elemente je
     sichtbar schaltet — dann lieber sofort alles zeigen. Dasselbe gilt,
     wenn weniger Bewegung gewuenscht ist. */
  if (wenigerBewegung.matches || !("IntersectionObserver" in window)) {
    elemente.forEach((element) => element.classList.add("is-revealed"));
  } else {
    /* Abschnittsweise gruppieren, damit die Verzoegerung innerhalb eines
       Abschnitts zaehlt und nicht ueber die ganze Seite hinweg. */
    const beobachter = new IntersectionObserver(
      (eintraege) => {
        const sichtbar = eintraege.filter((eintrag) => eintrag.isIntersecting);

        const proAbschnitt = new Map<Element, Element[]>();
        for (const eintrag of sichtbar) {
          const abschnitt = eintrag.target.closest("section") ?? document.body;
          const liste = proAbschnitt.get(abschnitt) ?? [];
          liste.push(eintrag.target);
          proAbschnitt.set(abschnitt, liste);
        }

        for (const liste of proAbschnitt.values()) {
          liste.forEach((ziel, position) => {
            /* Gedeckelt: bei vielen Karten wartet man sonst auf die letzte. */
            const verzoegerung = Math.min(position * 60, 360);
            window.setTimeout(() => ziel.classList.add("is-revealed"), verzoegerung);
            beobachter.unobserve(ziel);
          });
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
    );

    elemente.forEach((element) => beobachter.observe(element));
  }
</script>
